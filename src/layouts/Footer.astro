---
import { siteConfig } from '@/site.config'
---

<footer role="contentinfo">
  <ul class="flex justify-center gap-4">
    <li>
      <a
        class="text-primary underline-offset-4 hover:underline focus:underline focus:outline-2 focus:outline-offset-1 focus:outline-primary"
        href={siteConfig.socials[1].href}
        rel="noopener noreferrer">{siteConfig.socials[1].title}</a
      >
    </li>
    <li aria-hidden="true">/</li>
    <li>
      <a
        class="text-primary underline-offset-4 hover:underline focus:underline focus:outline-2 focus:outline-offset-1 focus:outline-primary"
        href={siteConfig.socials[2].href}
        rel="noopener noreferrer">{siteConfig.socials[2].title}</a
      >
    </li>
    <li aria-hidden="true">/</li>
    <li>
      <a
        class="text-primary underline-offset-4 hover:underline focus:underline focus:outline-2 focus:outline-offset-1 focus:outline-primary"
        href={siteConfig.socials[0].href}>{siteConfig.socials[0].title}</a
      >
    </li>
  </ul>
</footer>
